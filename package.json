{
  "name": "quickgit",
  "version": "1.0.0",
  "private": true,
  "description": "Personal tracker for live GitHub Pages URLs across repos — API + MCP server + PWA on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute quickgit --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute quickgit --remote --file=./schema.sql",
    "types": "wrangler types"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agents": "^0.0.100",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250601.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.112.0"
  }
}
